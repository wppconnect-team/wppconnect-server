{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":prHourlyLimitNone",
    ":prNotPending",
    ":semanticCommits"
  ],
  "prConcurrentLimit": 3,
  "baseBranches": ["main", "develop"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Use bump strategy",
      "matchPackagePatterns": ["*"],
      "rangeStrategy": "bump",
      "semanticCommitType": "build",
      "labels": ["dependencies"]
    },
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "addLabels": ["github_actions"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "matchDepTypes": ["devDependencies"],
      "semanticCommitScope": "deps-dev"
    },
    {
      "description": "Show in changelog package updates",
      "matchPackagePatterns": ["^@wppconnect/", "^@wppconnect-team/"],
      "semanticCommitType": "fix"
    },
    {
      "description": "Automatically merge minor and patch-level updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeStrategy": "squash",
      "automergeType": "pr"
    },
    {
      "description": "Keep WhatsApp runtimes current, but require the QR matrix before merging",
      "matchPackageNames": [
        "@wppconnect-team/wppconnect",
        "@wppconnect/wa-js",
        "@wppconnect/baileys",
        "@wppconnect/whaileys",
        "@wppconnect/zapo",
        "@zapo-js/store-sqlite",
        "@whiskeysockets/baileys",
        "whaileys",
        "zapo-js"
      ],
      "groupName": "WhatsApp provider runtimes",
      "automerge": false
    }
  ]
}
